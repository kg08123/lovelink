<div class="discover-top">
  <span class="pill ok"><%- icon('heart', true) %> <%= freeLeft %> / <%= FREE_MATCHES %> free matches left</span>
  <% if (!user.is_premium) { %><a class="pill warn" href="/premium">Go Premium <%- icon('chevronRight') %></a><% } else { %><span class="pill ok"><%- icon('star', true) %> Premium</span><% } %>
</div>
<% if (!card) { %>
  <div class="empty"><%- icon('heart') %><h2><%= t('noMoreProfiles') %></h2>
    <p class="sub">Here are more people nearby — including ones you already passed. Tap the heart to like anyone.</p>
    <form method="post" action="/discover/reset-passes" style="margin:14px 0 8px">
      <button class="btn btn-pink" type="submit"><%= t('showAgain') %></button>
    </form></div>
  <% if (grid && grid.items.length) { %>
  <div class="tabs">
    <a href="/discover?tab=nearby" class="<%= grid.f.tab==='nearby'?'on':'' %>"><%= t('nearby') %></a>
    <a href="/discover?tab=online" class="<%= grid.f.tab==='online'?'on':'' %>"><%= t('online') %></a>
    <a href="/discover?tab=new" class="<%= grid.f.tab==='new'?'on':'' %>"><%= t('new') %></a>
  </div>
  <p class="count"><%= grid.total %> <%= grid.total===1?'person':'people' %> found</p>
  <div class="explore-grid">
    <% grid.items.forEach(function(it){ %>
    <div class="explore-card">
      <a class="explore-card-link" href="/u/<%= it.id %>">
        <% if (it.photo1) { %><img src="<%= it.thumb || it.photo1 %>" alt="<%= it.name %>" loading="lazy" decoding="async"><% } else { %><div class="explore-ph"><%- icon('user') %></div><% } %>
        <div class="explore-info">
          <b><%= it.name %></b>
          <span><%= it.age %> · <%= it.distanceText || it.city || '' %></span>
          <span class="explore-score"><%= it.score %>% match</span>
        </div>
        <% if (it.online) { %><span class="online-dot" title="Online"></span><% } %>
      </a>
      <% if (it.matched) { %>
        <button class="explore-like liked" type="button" disabled title="Matched"><%- icon('heart', true) %></button>
      <% } else if (it.swipedKind === 'like' || it.swipedKind === 'super') { %>
        <button class="explore-like liked" type="button" disabled title="Liked"><%- icon('heart', true) %></button>
      <% } else { %>
        <form class="explore-like-form" method="post" action="/discover/grid-like">
          <input type="hidden" name="to" value="<%= it.id %>">
          <button class="explore-like" type="submit" title="<%= t('like') %>" aria-label="<%= t('like') %> <%= it.name %>"><%- icon('heart') %></button>
        </form>
      <% } %>
    </div>
    <% }) %>
  </div>
  <div class="pager">
    <% if (grid.page > 1) { %><a class="btn btn-outline btn-sm" href="/discover?<%= qs({tab: grid.f.tab, page: grid.page-1}) %>"><%- icon('chevronLeft') %> Prev</a><% } %>
    <span class="pager-info">Page <%= grid.page %> / <%= grid.totalPages %></span>
    <% if (grid.page < grid.totalPages) { %><a class="btn btn-outline btn-sm" href="/discover?<%= qs({tab: grid.f.tab, page: grid.page+1}) %>">Next <%- icon('chevronRight') %></a><% } %>
  </div>
  <% } %>
<% } else { %>
  <div class="swipe-card">
    <% if (card.photo1) { %>
    <a class="swipe-photo-link" href="/u/<%= card.id %>"><img class="swipe-photo" src="<%= card.thumb || card.photo1 %>" alt="<%= card.name %>"></a>
    <% } %>
    <% if (card.online) { %><span class="online-badge"><span class="online-dot"></span> <%= t('online') %></span><% } %>
    <span class="match-badge"><%= card.score %>% match</span>
    <div class="swipe-info">
      <div style="display:flex; align-items:flex-start; gap:8px">
        <div style="min-width:0; flex:1">
          <a href="/u/<%= card.id %>" class="swipe-name"><%= card.name %>, <%= card.age %> <span class="verified-badge"><%- icon('check') %></span></a>
          <div class="swipe-meta"><%- icon('pin') %> <%= card.distanceText || (card.city || '') %> · <%= card.city || '' %></div>
        </div>
        <a class="swipe-info-btn" href="/u/<%= card.id %>" aria-label="View profile"><%- icon('info') %></a>
      </div>
      <% if (card.bio) { %><p class="swipe-bio"><%= card.bio %></p><% } %>
      <div class="chips">
        <% interestsList.forEach(function(it){ %><span class="chip sm"><%= it %></span><% }) %>
      </div>
    </div>
  </div>
  <div class="swipe-actions">
    <form method="post" action="/discover/rewind"><button class="swipe-btn rewind" title="<%= t('rewind') %>" aria-label="<%= t('rewind') %>"><%- icon('rewind') %></button></form>
    <form method="post" action="/discover/swipe"><input type="hidden" name="to" value="<%= card.id %>"><input type="hidden" name="kind" value="pass"><button class="swipe-btn pass" title="<%= t('pass') %>" aria-label="<%= t('pass') %>"><%- icon('x') %></button></form>
    <form method="post" action="/discover/swipe"><input type="hidden" name="to" value="<%= card.id %>"><input type="hidden" name="kind" value="like"><button class="swipe-btn like" title="<%= t('like') %>" aria-label="<%= t('like') %>"><%- icon('heart', true) %></button></form>
    <form method="post" action="/discover/swipe"><input type="hidden" name="to" value="<%= card.id %>"><input type="hidden" name="kind" value="super"><button class="swipe-btn super" title="<%= t('superLike') %>" aria-label="<%= t('superLike') %>"><%- icon('star', true) %></button></form>
  </div>
  <p class="sub" style="text-align:center"><%= remaining %> <%= remaining===1?'profile':'profiles' %> near you · <a class="link" href="/u/<%= card.id %>">View full profile <%- icon('chevronRight') %></a></p>
<% } %>
