<div id="discover-root" class="discover-root">
<% if (typeof loadingOverlay !== 'undefined' && loadingOverlay) { %>
<div class="dl-overlay" id="discoverLoading" aria-hidden="true">
  <div class="dl-orbit">
    <div class="dl-ring r1"></div>
    <div class="dl-ring r2"></div>
    <div class="dl-heart"><%- icon('heart', true) %></div>
    <span class="dl-chip c1"><%- icon('user') %></span>
    <span class="dl-chip c2"><%- icon('sparkles') %></span>
    <span class="dl-chip c3"><%- icon('heart', true) %></span>
    <span class="dl-chip c4"><%- icon('pin') %></span>
  </div>
  <h1 class="dl-title"><%= t('loadingMatches') %></h1>
  <p class="dl-sub"><%- icon('crosshair') %> <%= t('loadingNearYou') %></p>
  <div class="dl-dots"><span></span><span></span><span></span><span></span></div>
  <div class="dl-bar"><span></span></div>
</div>
<% } %>
<% if (typeof hasCoords !== 'undefined' && !hasCoords) { %>
<!-- Location banner: only for signed-in users with no stored coordinates
     (server-side hasCoords). Non-modal, sits above the deck; dismiss hides
     it for the session. Strings ride on data attributes for instant.js. -->
<div class="loc-banner" id="locBanner" role="region" aria-label="<%= t('locBannerTitle') %>"
  data-msg-saved="<%= t('locBannerSaved') %>" data-msg-fallback="<%= t('locGpsFallback') %>"
  data-msg-denied="<%= t('locDenied') %>" data-msg-both-failed="<%= t('locBothFailed') %>"
  data-msg-ip-failed="<%= t('locIpFailed') %>" data-msg-locating="<%= t('locating') %>"
  data-msg-detecting="<%= t('locDetecting') %>" data-msg-unsupported="<%= t('locUnsupported') %>"
  data-msg-save-failed="<%= t('locSaveFailed') %>">
  <button class="loc-banner-x" type="button" id="locBannerDismiss" aria-label="Dismiss">&times;</button>
  <div class="loc-banner-icon"><%- icon('pin') %></div>
  <div class="loc-banner-body">
    <div class="loc-banner-title"><%= t('locBannerTitle') %></div>
    <p class="loc-banner-sub"><%= t('locBannerSub') %></p>
    <div class="loc-banner-actions">
      <button class="btn btn-pink btn-sm" type="button" id="locBannerGps"><%= t('locBannerShare') %></button>
      <button class="btn btn-outline btn-sm" type="button" id="locBannerIp"><%= t('locBannerDetect') %></button>
    </div>
    <p class="loc-banner-status" id="locBannerStatus" hidden></p>
  </div>
</div>
<% } %>
<% if (!card) { %>
  <div class="empty fs-empty"><%- icon('heart') %><h2><%= t('caughtUp') %></h2>
    <form class="js-reset-form" method="post" action="/discover/reset-passes" style="margin:14px 0 8px">
      <button class="btn btn-pink" type="submit"><%= t('showAgain') %></button>
    </form></div>
<% } else { %>
  <div class="swipe-stack fs-stack">
    <% if (typeof next !== 'undefined' && next) { %>
    <div class="swipe-card fs-card peek" aria-hidden="true">
      <% if (next.photo1) { %><img class="swipe-photo fs-photo" src="<%= next.photo1 %>" alt="" draggable="false"><% } %>
    </div>
    <% } %>
    <div class="swipe-card fs-card" data-card-id="<%= card.id %>" data-photos='<%= JSON.stringify(card.photos || []) %>'>
    <% if (card.photo1) { %>
    <div class="swipe-photo-link fs-photo-wrap">
      <img class="swipe-photo fs-photo" src="<%= card.photo1 %>" alt="<%= card.name %>" draggable="false">
      <div class="photo-zones" aria-hidden="true"><span class="pz pz-prev"></span><span class="pz pz-next"></span></div>
    </div>
    <% } else { %>
    <div class="swipe-photo-link fs-photo-wrap"><div class="fs-photo-ph"><%- icon('user') %></div></div>
    <% } %>
    <% var barPhotos = (card.photos && card.photos.length) ? card.photos : [1]; %>
    <div class="story-bars"><% barPhotos.forEach(function(_, i){ %><span class="story-bar<%= i===0 ? ' on' : '' %>"></span><% }) %></div>
    <span class="stamp stamp-like" aria-hidden="true">LIKE</span>
    <span class="stamp stamp-nope" aria-hidden="true">NOPE</span>
    <div class="swipe-info fs-info">
      <div class="fs-name-row">
        <a href="/u/<%= card.id %>" class="swipe-name"><span class="nm"><%= card.name %>, <%= card.age %></span> <% if (card.verified) { %><span class="verified-badge"><%- icon('check') %></span><% } %><% if (card.presence === 'online') { %><span class="online-dot fs-online-dot"></span><span class="online-txt">Online</span><% } else if (card.presence === 'recent') { %><span class="online-dot fs-online-dot recent"></span><span class="online-txt recent"><%= t('recentlyOnline') %></span><% } %></a>
        <a class="fs-expand" href="/u/<%= card.id %>" aria-label="View full profile"><%- icon('chevronUp') %></a>
      </div>
      <div class="fs-infobox">
        <span class="fs-info-line"><%- icon('pin') %> <%= card.city || '' %><%= card.country ? ', ' + card.country : '' %><% if (card.distanceText) { %> • <%= card.distanceText.replace(' away', '') %><% } %></span>
        <span class="fs-info-line"><%- icon('handshake') %> <% if (card.relationship_goal === 'friendship') { %>New friends<% } else if (card.relationship_goal === 'serious') { %>Serious dating<% } else if (card.relationship_goal === 'marriage') { %>Marriage<% } else if (card.relationship_goal === 'casual') { %>Casual dating<% } else { %>Looking to meet<% } %></span>
      </div>
    </div>
    </div>
  </div>
  <div class="swipe-actions fs-actions">
    <form class="js-swipe-form" method="post" action="/discover/swipe"><input type="hidden" name="to" value="<%= card.id %>"><input type="hidden" name="kind" value="pass"><button class="swipe-btn pass" type="submit" title="<%= t('pass') %>" aria-label="<%= t('pass') %>"><%- icon('x') %></button></form>
    <form class="js-message-form" method="post" action="/discover/message"><input type="hidden" name="to" value="<%= card.id %>"><button class="swipe-btn msg" type="submit" title="Message" aria-label="Message"><%- icon('comment') %></button></form>
    <form class="js-swipe-form" method="post" action="/discover/swipe"><input type="hidden" name="to" value="<%= card.id %>"><input type="hidden" name="kind" value="like"><button class="swipe-btn like" type="submit" title="<%= t('like') %>" aria-label="<%= t('like') %>"><%- icon('heart', true) %></button></form>
  </div>
<% } %>
<%- include('partials/premium-sheet') %>
</div>
