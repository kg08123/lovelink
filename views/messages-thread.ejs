<% function dayLabel(d){ var now = new Date(); var today = new Date(now.getFullYear(), now.getMonth(), now.getDate()); var day = new Date(d.getFullYear(), d.getMonth(), d.getDate()); var diff = Math.round((today - day) / 86400000); if (diff === 0) return 'Today'; if (diff === 1) return 'Yesterday'; return d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }); } %>
<% function timeLabel(d){ return d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }); } %>
<header class="chat-head">
  <a class="chat-head-back" href="/messages" aria-label="Back to messages"><%- icon('chevronLeft') %></a>
  <a class="chat-head-who" href="/u/<%= conv.other_id %>">
    <% if (conv.other_thumb || conv.other_photo) { %><img class="chat-head-avatar" src="<%= conv.other_thumb || conv.other_photo %>" alt=""><% } else { %><div class="chat-head-avatar avatar-ph"><%- icon('user') %></div><% } %>
    <span class="chat-head-name"><%= conv.other_name %><% if (conv.other_online) { %><small class="chat-head-online"><span class="online-dot"></span> Online</small><% } %></span>
  </a>
  <button class="chat-head-menu-btn" type="button" id="chatMenuBtn" aria-label="More options" aria-haspopup="true"><%- icon('more') %></button>
  <div class="chat-menu" id="chatMenu" hidden>
    <a href="/u/<%= conv.other_id %>"><%- icon('user') %> View Profile</a>
    <form method="post" action="/u/<%= conv.other_id %>/block"><button type="submit"><%- icon('ban') %> Block <%= conv.other_name %></button></form>
  </div>
</header>
<div class="chat" id="chat">
  <% var lastDay = null; %>
  <% messages.forEach(function(m){ %>
    <% var d = new Date(m.created_at); var dayKey = d.toDateString(); %>
    <% if (dayKey !== lastDay) { lastDay = dayKey; %>
    <div class="chat-date" data-day="<%= dayKey %>"><%= dayLabel(d) %></div>
    <% } %>
    <div class="bubble <%= m.sender_user_id===user.id?'mine':'theirs' %>">
      <% if (m.image_data) { %><a href="<%= m.image_data %>" target="_blank" rel="noopener"><img class="chat-img" src="<%= m.image_thumb || m.image_data %>" alt="" loading="lazy" decoding="async"></a><% } %>
      <% if (m.body) { %><p><%= m.body %></p><% } %>
      <small><%= timeLabel(d) %></small>
    </div>
  <% }) %>
</div>
<div id="imgPrev" class="img-prev" hidden>
  <img id="imgPrevImg" alt="">
  <button type="button" id="imgRm" class="img-prev-x" aria-label="<%= t('removeImage') %>"><%- icon('x') %></button>
</div>
<div id="imgErr" class="img-prev-err" hidden></div>
<form id="sendform" method="post" action="/messages/<%= conv.id %>" class="chatbar" enctype="multipart/form-data">
  <button type="button" class="icon-btn ghost" id="imgBtn" aria-label="<%= t('chooseImage') %>"><%- icon('image') %></button>
  <input type="file" id="imgInput" name="image" accept="image/*" hidden>
  <input type="text" name="body" placeholder="<%= t('typeMessage') %>" autocomplete="off" maxlength="2000">
  <button class="icon-btn" type="submit" aria-label="<%= t('send') %>"><%- icon('send') %></button>
</form>
<script>
(function(){
  var chat=document.getElementById('chat');
  var lastId=<%= messages.length ? messages[messages.length-1].id : 0 %>;
  var lastDayKey=<%= messages.length ? "'" + new Date(messages[messages.length-1].created_at).toDateString() + "'" : 'null' %>;
  chat.scrollTop=chat.scrollHeight;
  function dayLabelFor(d){
    var now=new Date();
    var today=new Date(now.getFullYear(), now.getMonth(), now.getDate());
    var day=new Date(d.getFullYear(), d.getMonth(), d.getDate());
    var diff=Math.round((today-day)/86400000);
    if(diff===0) return 'Today';
    if(diff===1) return 'Yesterday';
    return d.toLocaleDateString('en-US',{month:'short',day:'2-digit',year:'numeric'});
  }
  function timeLabelFor(d){ return d.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'}); }
  function addMsg(m){
    if(m.id<=lastId) return;
    lastId=m.id;
    if(m.mine){
      chat.querySelectorAll('.bubble.temp').forEach(function(t){
        var tp=t.querySelector('p');
        var tBody=tp?tp.textContent:'';
        var tImg=!!t.querySelector('img');
        if(tBody===(m.body||'') && tImg===!!m.has_image){ t.remove(); }
      });
    }
    var d=new Date(m.created_at);
    var dayKey=d.toDateString();
    if(dayKey!==lastDayKey){
      lastDayKey=dayKey;
      var sep=document.createElement('div');
      sep.className='chat-date'; sep.setAttribute('data-day', dayKey);
      sep.textContent=dayLabelFor(d);
      chat.appendChild(sep);
    }
    var div=document.createElement('div');
    div.className='bubble '+(m.mine?'mine':'theirs');
    if(m.has_image&&m.image_data){
      var a=document.createElement('a'); a.href=m.image_full||m.image_data; a.target='_blank'; a.rel='noopener';
      var im=document.createElement('img'); im.className='chat-img'; im.src=m.image_data; im.alt=''; im.loading='lazy'; im.decoding='async';
      a.appendChild(im); div.appendChild(a);
    }
    if(m.body){ var p=document.createElement('p'); p.textContent=m.body; div.appendChild(p); }
    var s=document.createElement('small'); s.textContent=timeLabelFor(d);
    div.appendChild(s); chat.appendChild(div);
    chat.scrollTop=chat.scrollHeight;
  }
  // Chat speed: poll every 3s as a chained timeout (never overlapping).
  // A tick is skipped while a fetch is still in flight, polling pauses
  // entirely while the tab is hidden, and failures back off (3s, 6s,
  // 12s, 24s, 48s) instead of hammering the server every 2s.
  var POLL_MS = 3000, pollTimer = null, pollInFlight = false, pollBackoff = 0;
  function schedulePoll(ms){ clearTimeout(pollTimer); pollTimer = setTimeout(tick, ms); }
  async function tick(){
    // While hidden, keep the timer chain alive (no fetch) so the chain
    // can never die if the page loads in a background tab; the
    // visibilitychange handler restarts polling immediately on return.
    if (document.hidden) { schedulePoll(POLL_MS); return; }
    if (pollInFlight) { schedulePoll(500); return; }
    pollInFlight = true;
    try{
      var r=await fetch('/messages/<%= conv.id %>/json?after='+lastId,{headers:{'Accept':'application/json','X-Requested-With':'XMLHttpRequest'}});
      if(!r.ok) throw new Error('poll '+r.status);
      var d=await r.json();
      d.messages.forEach(addMsg);
      pollBackoff = 0;
    }catch(e){ pollBackoff = Math.min(pollBackoff + 1, 4); }
    finally{ pollInFlight = false; }
    schedulePoll(POLL_MS * Math.pow(2, pollBackoff));
  }
  function poll(){ clearTimeout(pollTimer); tick(); }
  schedulePoll(POLL_MS);
  document.addEventListener('visibilitychange', function(){
    if (document.hidden) { clearTimeout(pollTimer); }
    else { tick(); }
  });
  // 3-dot menu: View Profile / Block.
  var menuBtn=document.getElementById('chatMenuBtn'), menu=document.getElementById('chatMenu');
  if(menuBtn && menu){
    menuBtn.addEventListener('click', function(e){ e.stopPropagation(); menu.hidden = !menu.hidden; });
    document.addEventListener('click', function(e){ if(!menu.hidden && !menu.contains(e.target)) menu.hidden = true; });
  }
  var form=document.getElementById('sendform');
  var input=form.querySelector('input[name=body]');
  var imgInput=document.getElementById('imgInput'), imgFile=null;
  document.getElementById('imgBtn').addEventListener('click',function(){ imgInput.click(); });
  imgInput.addEventListener('change',function(){
    var pv=document.getElementById('imgPrev'), err=document.getElementById('imgErr');
    imgFile=imgInput.files[0]||null;
    if(err) err.hidden=true;
    if(!imgFile){ pv.hidden=true; return; }
    if(imgFile.type.indexOf('image/')!==0){
      imgInput.value=''; imgFile=null; pv.hidden=true;
      if(err){ err.textContent='<%= t('imageOnly') %>'; err.hidden=false; }
      return;
    }
    if(imgFile.size>3*1024*1024){
      imgInput.value=''; imgFile=null; pv.hidden=true;
      if(err){ err.textContent='<%= t('imageTooBig') %>'; err.hidden=false; }
      return;
    }
    var reader=new FileReader();
    reader.onload=function(e){
      var im=document.getElementById('imgPrevImg');
      im.onerror=function(){ pv.hidden=true; if(err){ err.textContent='<%= t('imageOnly') %>'; err.hidden=false; } };
      im.src=e.target.result;
      pv.hidden=false;
    };
    reader.readAsDataURL(imgFile);
  });
  document.getElementById('imgRm').addEventListener('click',function(){
    imgInput.value=''; imgFile=null; document.getElementById('imgPrevImg').removeAttribute('src'); document.getElementById('imgPrev').hidden=true;
  });
  form.addEventListener('submit',function(e){
    e.preventDefault();
    var text=input.value.trim();
    if(!text&&!imgFile) return;
    var fd=new FormData();
    fd.append('body',text);
    if(imgFile) fd.append('image',imgFile);
    var imgData=imgFile?document.getElementById('imgPrevImg').src:null;
    var tmp=document.createElement('div');
    tmp.className='bubble mine temp';
    if(imgData){ var ta=document.createElement('a'); ta.href=imgData; ta.target='_blank'; ta.rel='noopener'; var tim=document.createElement('img'); tim.className='chat-img'; tim.src=imgData; ta.appendChild(tim); tmp.appendChild(ta); }
    if(text){ var tp=document.createElement('p'); tp.textContent=text; tmp.appendChild(tp); }
    var ts=document.createElement('small'); ts.textContent='Sending…'; tmp.appendChild(ts);
    chat.appendChild(tmp); chat.scrollTop=chat.scrollHeight;
    input.value=''; imgInput.value=''; imgFile=null;
    document.getElementById('imgPrevImg').removeAttribute('src');
    document.getElementById('imgPrev').hidden=true;
    fetch(form.action,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest'},body:fd})
      .then(function(r){ if(r.ok) poll(); else form.submit(); })
      .catch(function(){ form.submit(); });
  });
})();
</script>
