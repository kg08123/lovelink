<div class="landing-hero">
  <div class="landing-hearts" aria-hidden="true"><%- icon('heart', true) %><%- icon('heart', true) %><%- icon('heart', true) %><%- icon('heart', true) %><%- icon('heart', true) %></div>
  <div class="landing-logo"><span class="logo-heart big"><%- icon('heart', true) %></span></div>
  <h1 class="landing-title">Love<span class="logo-link">Link</span></h1>
  <p class="landing-tag"><%= t('appTag') %></p>
  <a class="btn btn-pink btn-block" href="/signup"><%= t('signUp') %></a>
  <a class="btn btn-outline-light btn-block" href="/signin"><%= t('signIn') %></a>
  <p class="social-label">Continue with</p>
  <div class="social-row">
    <% if (googleEnabled) { %>
    <a class="social-btn" href="/auth/google" aria-label="Continue with Google"><%- brand('google') %></a>
    <% } %>
    <a class="social-btn" href="/signup" aria-label="Continue with Apple"><%- brand('apple') %></a>
    <a class="social-btn" href="/signup" aria-label="Continue with Facebook"><%- brand('facebook') %></a>
  </div>
  <p class="landing-fine">By continuing, you agree to our <a href="/privacy">Terms &amp; Privacy Policy</a>.<br>18+ only.</p>
  <p class="landing-lang"><a href="?lang=en" class="<%= lang==='en'?'on':'' %>">English</a> · <a href="?lang=am" class="<%= lang==='am'?'on':'' %>">አማርኛ</a></p>
</div>
