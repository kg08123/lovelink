<div class="landing-hero">
  <div class="landing-bokeh" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <div class="landing-top">
    <div class="landing-mark" aria-hidden="true">
      <svg class="mark-hearts" viewBox="0 0 120 74" fill="none">
        <defs>
          <linearGradient id="lhg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#FF7AA2"/>
            <stop offset=".55" stop-color="#FF2E63"/>
            <stop offset="1" stop-color="#D10F4B"/>
          </linearGradient>
        </defs>
        <g transform="translate(4 2) scale(2.5)">
          <path fill="url(#lhg)" d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </g>
        <g transform="translate(54 16) scale(2.1)">
          <path fill="none" stroke="#FF5C8A" stroke-width="1.7" stroke-linejoin="round" d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </g>
      </svg>
    </div>
    <h1 class="landing-title">Love<span class="logo-link">Link</span></h1>
    <svg class="landing-swoosh" viewBox="0 0 260 20" fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="lsg" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#FF7AA2"/>
          <stop offset=".55" stop-color="#FF2E63"/>
          <stop offset="1" stop-color="#D10F4B"/>
        </linearGradient>
      </defs>
      <path d="M4 14 C 70 2, 190 2, 256 9" stroke="url(#lsg)" stroke-width="6" stroke-linecap="round"/>
    </svg>
    <p class="landing-tag"><%= t('appTag') %></p>
  </div>
  <div class="landing-actions">
    <a class="landing-cta landing-cta-primary" href="/signup">
      <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
      <span class="cta-label"><%= t('signUp') %></span>
      <%- icon('chevronRight') %>
    </a>
    <a class="landing-cta landing-cta-ghost" href="/signin">
      <%- icon('user') %>
      <span class="cta-label"><%= t('signIn') %></span>
      <%- icon('chevronRight') %>
    </a>
    <p class="social-label"><span>Continue with</span></p>
    <div class="social-row">
      <% if (googleEnabled) { %>
      <a class="social-btn social-google" href="/auth/google" aria-label="Continue with Google"><%- brand('google') %></a>
      <% } %>
      <a class="social-btn social-apple" href="/signup" aria-label="Continue with Apple"><%- brand('apple') %></a>
      <a class="social-btn social-facebook" href="/signup" aria-label="Continue with Facebook"><%- brand('facebook') %></a>
    </div>
    <p class="landing-fine"><span class="fine-check" aria-hidden="true"><%- icon('check') %></span><span>By continuing, you agree to our <a href="/privacy">Terms &amp; Privacy Policy</a>.<br>18+ only.</span></p>
    <p class="landing-lang"><span class="lang-globe" aria-hidden="true"><%- icon('globe') %></span><a href="?lang=en" class="<%= lang==='en'?'on':'' %>">English</a><span class="lang-div" aria-hidden="true"></span><a href="?lang=am" class="<%= lang==='am'?'on':'' %>">አማርኛ</a></p>
  </div>
  <div class="landing-wave" aria-hidden="true">
    <svg viewBox="0 0 430 90" preserveAspectRatio="none">
      <path d="M0,58 C110,18 250,88 430,42 L430,90 L0,90 Z" fill="rgba(255,46,99,.30)"/>
      <path d="M0,72 C130,38 280,92 430,60 L430,90 L0,90 Z" fill="rgba(255,46,99,.55)"/>
    </svg>
  </div>
  <span class="landing-side-heart sh-left" aria-hidden="true"><%- icon('heart') %></span>
  <span class="landing-side-heart sh-right" aria-hidden="true"><%- icon('heart') %></span>
</div>
