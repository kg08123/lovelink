<div class="landing-hero">
  <div class="landing-hearts" aria-hidden="true">❤️ 💕 ❤️ 💕 ❤️</div>
  <div class="landing-logo"><span class="logo-heart big">❤️</span></div>
  <h1 class="landing-title">Love<span class="logo-link">Link</span></h1>
  <p class="landing-tag"><%= t('appTag') %></p>
  <a class="btn btn-pink btn-block" href="/signup"><%= t('signUp') %></a>
  <a class="btn btn-outline-light btn-block" href="/signin"><%= t('signIn') %></a>
  <% if (googleEnabled) { %>
  <div class="or-row light"><span>or</span></div>
  <a class="btn btn-google" href="/auth/google"><span class="g-logo">G</span> Continue with Google</a>
  <% } %>
  <p class="landing-fine">By continuing, you agree to our <a href="/privacy">Terms &amp; Privacy Policy</a>.<br>18+ only.</p>
  <p class="landing-lang"><a href="?lang=en" class="<%= lang==='en'?'on':'' %>">English</a> · <a href="?lang=am" class="<%= lang==='am'?'on':'' %>">አማርኛ</a></p>
</div>
