<h1 class="page-title"><%= profile ? t('editProfile') : t('onboardingTitle') %></h1>
<p class="sub">Answer honestly — your answers pick your best matches. Your exact location is never shown to others, only the distance.</p>
<% if (!profile) { %>
<div class="steps" aria-hidden="true"><span class="done"></span><span class="done"></span><span></span><span></span></div>
<p class="sub" style="font-size:.82rem">Step 1 of 1 — a few questions, then you meet your matches. Photos are shrunk automatically, so any phone photo works.</p>
<% } %>
<form method="post" action="/onboarding" enctype="multipart/form-data" id="onbForm">
  <div class="section">
    <h2><%- icon('camera') %> <%= t('profile') %></h2>
    <% if (profile && profile.photo1) { %><img class="avatar-lg" src="<%= profile.photo1 %>" alt="" style="width:120px;height:150px;border-radius:16px;object-fit:cover"><% } %>
    <div class="field"><label>Main photo * <%= profile ? '(leave empty to keep current)' : '' %></label>
      <label class="upload-zone"><%- icon('camera') %><b>Tap to upload your main photo</b><small>Any phone photo works — shrunk automatically. Face visible.</small><input type="file" name="photo1" accept="image/*" data-upz="upz1" <%= profile ? '' : 'required' %>></label>
      <div class="upz-prev" id="upz1"><img alt=""><span class="upz-name"></span><button type="button" class="upz-x" data-clear="photo1" aria-label="Remove photo"><%- icon('x') %></button></div>
      <div class="hint">A clear photo of you, face visible.</div>
    </div>
    <div class="field"><label>Photo 2 (optional)</label>
      <label class="upload-zone"><%- icon('camera') %><b>Tap to add a second photo</b><small>Optional — shows more of you.</small><input type="file" name="photo2" accept="image/*" data-upz="upz2"></label>
      <div class="upz-prev" id="upz2"><img alt=""><span class="upz-name"></span><button type="button" class="upz-x" data-clear="photo2" aria-label="Remove photo"><%- icon('x') %></button></div>
    </div>
    <div class="field"><label>Photo 3 (optional)</label>
      <label class="upload-zone"><%- icon('camera') %><b>Tap to add a third photo</b><small>Optional — shows more of you.</small><input type="file" name="photo3" accept="image/*" data-upz="upz3"></label>
      <div class="upz-prev" id="upz3"><img alt=""><span class="upz-name"></span><button type="button" class="upz-x" data-clear="photo3" aria-label="Remove photo"><%- icon('x') %></button></div>
    </div>
    <div class="field"><label><%= t('aboutMe') %></label>
      <textarea name="bio" maxlength="500" placeholder="Dream big, work hard, and enjoy life"><%= (profile && profile.bio) || form.bio || '' %></textarea>
    </div>
  </div>

  <div class="section">
    <h2><%- icon('pin') %> <%= t('useMyLocation') %></h2>
    <div class="field"><label>City *</label>
      <input type="text" name="city" id="cityInput" required value="<%= (profile && profile.city) || form.city || '' %>" placeholder="Addis Ababa">
    </div>
    <input type="hidden" name="latitude" id="latInput" value="<%= (profile && profile.latitude) || form.latitude || '' %>">
    <input type="hidden" name="longitude" id="lngInput" value="<%= (profile && profile.longitude) || form.longitude || '' %>">
    <div class="loc-box">
      <div class="loc-status" id="locStatus"><%= (profile && profile.latitude && profile.longitude) ? t('locSetIs') + (profile.city || '') + ' (' + Number(profile.latitude).toFixed(4) + ', ' + Number(profile.longitude).toFixed(4) + ')' : t('locNotSet') %></div>
      <div class="loc-actions">
        <button type="button" class="btn btn-outline" id="locBtn"><%- icon('pin') %> <%= t('useMyLocation') %></button>
        <button type="button" class="btn btn-outline" id="ipBtn"><%- icon('globe') %> <%- t('locDetectCity') %></button>
      </div>
    </div>
    <div class="hint">We store your city + coordinates so matches are sorted by real distance. Only the distance (e.g. “2 km away”) is shown — never your exact spot. "Detect my city" uses your internet connection and is approximate; GPS is exact.</div>
  </div>

  <div class="section">
    <h2><%- icon('user') %> About you</h2>
    <div class="field"><label>Height (cm)</label><input type="number" name="height_cm" min="120" max="230" value="<%= (profile && profile.height_cm) || form.height_cm || '' %>"></div>
    <div class="field"><label>Religion</label>
      <select name="religion">
        <option value="">—</option>
        <% ['Orthodox','Protestant','Catholic','Muslim','Other','Prefer not to say'].forEach(function(r){ %>
        <option <%= (profile && profile.religion===r) || form.religion===r ? 'selected' : '' %>><%= r %></option>
        <% }) %>
      </select>
    </div>
    <div class="field"><label>Education</label>
      <select name="education">
        <option value="">—</option>
        <% ['High School','College','University','Masters','PhD'].forEach(function(r){ %>
        <option <%= (profile && profile.education===r) || form.education===r ? 'selected' : '' %>><%= r %></option>
        <% }) %>
      </select>
    </div>
    <div class="field"><label>Job</label><input type="text" name="job" value="<%= (profile && profile.job) || form.job || '' %>" placeholder="Teacher, Engineer..."></div>
    <div class="field"><label>Smoking</label>
      <select name="smoking">
        <option value="">—</option>
        <option value="never" <%= (profile && profile.smoking==='never')?'selected':'' %>>Never</option>
        <option value="sometimes" <%= (profile && profile.smoking==='sometimes')?'selected':'' %>>Sometimes</option>
        <option value="often" <%= (profile && profile.smoking==='often')?'selected':'' %>>Often</option>
      </select>
    </div>
    <div class="field"><label>Drinking</label>
      <select name="drinking">
        <option value="">—</option>
        <option value="never" <%= (profile && profile.drinking==='never')?'selected':'' %>>Never</option>
        <option value="sometimes" <%= (profile && profile.drinking==='sometimes')?'selected':'' %>>Sometimes</option>
        <option value="often" <%= (profile && profile.drinking==='often')?'selected':'' %>>Often</option>
      </select>
    </div>
    <div class="field"><label>Kids</label>
      <select name="kids">
        <option value="">—</option>
        <option value="none" <%= (profile && profile.kids==='none')?'selected':'' %>>No kids</option>
        <option value="have" <%= (profile && profile.kids==='have')?'selected':'' %>>Have kids</option>
        <option value="want" <%= (profile && profile.kids==='want')?'selected':'' %>>Want kids</option>
        <option value="dont_want" <%= (profile && profile.kids==='dont_want')?'selected':'' %>>Don't want kids</option>
      </select>
    </div>
  </div>

  <div class="section">
    <h2><%- icon('heart') %> What are you looking for?</h2>
    <div class="field"><label>Looking for</label>
      <select name="looking_for_gender">
        <option value="any" <%= (profile && profile.looking_for_gender==='any')?'selected':'' %>>Anyone</option>
        <option value="female" <%= (profile && profile.looking_for_gender==='female')?'selected':'' %>>Women</option>
        <option value="male" <%= (profile && profile.looking_for_gender==='male')?'selected':'' %>>Men</option>
      </select>
    </div>
    <div class="field"><label>Age range</label>
      <div style="display:flex;gap:8px">
        <input type="number" name="age_min" min="18" max="99" value="<%= (profile && profile.age_min) || form.age_min || 18 %>" style="flex:1">
        <span style="align-self:center">–</span>
        <input type="number" name="age_max" min="18" max="99" value="<%= (profile && profile.age_max) || form.age_max || 99 %>" style="flex:1">
      </div>
    </div>
    <div class="field"><label>Relationship goal</label>
      <select name="relationship_goal">
        <option value="">—</option>
        <option value="serious" <%= (profile && profile.relationship_goal==='serious')?'selected':'' %>>Serious relationship</option>
        <option value="marriage" <%= (profile && profile.relationship_goal==='marriage')?'selected':'' %>>Marriage</option>
        <option value="casual" <%= (profile && profile.relationship_goal==='casual')?'selected':'' %>>Casual dating</option>
        <option value="friendship" <%= (profile && profile.relationship_goal==='friendship')?'selected':'' %>>Friendship first</option>
      </select>
    </div>
    <div class="field"><label><%= t('interests') %> (pick all that fit)</label>
      <div class="chips">
        <% INTERESTS.forEach(function(it){ var cur = ((profile && profile.interests) || form.interests || '').split(','); %>
        <label class="chip-check"><input type="checkbox" name="interests" value="<%= it %>" <%= cur.includes(it)?'checked':'' %>> <%= it %></label>
        <% }) %>
      </div>
    </div>
    <div class="field"><label>Languages</label><input type="text" name="languages" value="<%= (profile && profile.languages) || form.languages || 'Amharic, English' %>"></div>
  </div>

  <button class="btn btn-pink btn-block" type="submit" id="saveBtn"><%= t('save') %></button>
  <p class="hint" id="saveHint" style="text-align:center"></p>
</form>
<script>
(function(){
  // ---- Real location: GPS first, internet city detection as fallback ----
  // Proven live failures this fixes:
  //  (1) GPS denied/timeout used to show one generic "failed" with no
  //      reason and no way forward — now the real reason + how to fix it.
  //  (2) GPS could succeed yet the city stayed empty: Nominatim returns
  //      NO "city" for Addis Ababa coords (only suburb/county/state, often
  //      in Amharic script), and its fetch failure was swallowed silently
  //      while the page still claimed "Location saved."
  var btn=document.getElementById('locBtn'), ipBtn=document.getElementById('ipBtn'),
      st=document.getElementById('locStatus'),
      latIn=document.getElementById('latInput'), lngIn=document.getElementById('lngInput'),
      cityIn=document.getElementById('cityInput');
  function showStatus(text, kind){
    st.textContent=text;
    st.className='loc-status' + (kind==='ok' ? ' loc-ok' : kind==='err' ? ' loc-err' : '');
  }
  function fmtCoord(lat, lng){ return ' (' + Number(lat).toFixed(4) + ', ' + Number(lng).toFixed(4) + ')'; }
  function setLoc(lat, lng, city, approx){
    latIn.value=lat; lngIn.value=lng;
    if(city) cityIn.value=city;
    showStatus((approx ? '<%- t('locApproxIs') %>' : '<%- t('locSetIs') %>') + (city || '') + fmtCoord(lat, lng), 'ok');
  }
  // Nominatim address -> city name. For Ethiopian coords it often returns
  // no "city" at all (Addis: suburb/county/state only, Amharic script),
  // or "ሀዋሳ / Hawassa" (Amharic + Latin). Prefer the Latin part, map
  // known Amharic names, never return a district like "Kirkos" as the city.
  var AM_CITY = {'አዲስ አበባ':'Addis Ababa','ሀዋሳ':'Hawassa','መቀሌ':'Mekelle','ባሕር ዳር':'Bahir Dar','ድሬዳዋ':'Dire Dawa','አዳማ':'Adama','ጅማ':'Jimma','ጎንደር':'Gondar','ደሴ':'Dessie','ጅጅጋ':'Jijiga','አርባ ምንጭ':'Arba Minch','ሐረር':'Harar','ነቀምት':'Nekemte','አሶሳ':'Asosa','ጋምቤላ':'Gambela','ሰመራ':'Semera'};
  function cleanCity(s){
    if(!s) return '';
    var v=String(s).trim();
    if(AM_CITY[v]) return AM_CITY[v];
    var parts=v.split('/');
    var latin=parts[parts.length-1].trim();
    if(AM_CITY[latin]) return AM_CITY[latin];
    if(!/[A-Za-z]/.test(latin)) return '';
    return latin;
  }
  function cityFromAddress(a){
    if(!a) return '';
    var c = cleanCity(a.city) || cleanCity(a.town) || cleanCity(a.municipality) || cleanCity(a.village);
    if(c) return c;
    return cleanCity(a.state) || cleanCity(a.state_district) || '';
  }
  function readCityName(lat, lng){
    // zoom=10 asks for city-level results; accept-language=en prefers
    // Latin names where OpenStreetMap has them.
    return fetch('https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat='+lat+'&lon='+lng+'&zoom=10&accept-language=en')
      .then(function(r){ return r.json(); })
      .then(function(d){ return cityFromAddress(d.address || {}); });
  }
  function geoError(err){
    if(err && err.code===1) showStatus('<%- t('locDenied') %>', 'err');
    else if(err && err.code===2) showStatus('<%- t('locUnavailable') %>', 'err');
    else showStatus('<%- t('locTimeout') %>', 'err');
  }
  if(btn) btn.addEventListener('click', function(){
    if(!navigator.geolocation){ showStatus('<%- t('locUnsupported') %>', 'err'); return; }
    showStatus('<%- t('locating') %>', '');
    navigator.geolocation.getCurrentPosition(function(pos){
      var lat=pos.coords.latitude, lng=pos.coords.longitude;
      latIn.value=lat; lngIn.value=lng;
      readCityName(lat, lng).then(function(city){
        if(city){ setLoc(lat, lng, city, false); }
        else showStatus('<%- t('locCityFailed') %>', 'err');
      }).catch(function(){ showStatus('<%- t('locCityFailed') %>', 'err'); });
    }, geoError, {enableHighAccuracy:false, timeout:15000, maximumAge:60000});
  });
  // One-tap fallback when GPS is denied/unavailable: detect the city from
  // the internet connection (approximate). ipwho.is is free, no key, and
  // allows browser (CORS) calls; ipapi.co is the second try.
  if(ipBtn) ipBtn.addEventListener('click', function(){
    showStatus('<%- t('locDetecting') %>', '');
    fetch('https://ipwho.is/')
      .then(function(r){ return r.json(); })
      .then(function(d){
        if(d && d.success && d.city && d.latitude) { setLoc(d.latitude, d.longitude, d.city, true); return; }
        throw new Error('ipwho: no city');
      })
      .catch(function(){
        return fetch('https://ipapi.co/json/')
          .then(function(r){ return r.json(); })
          .then(function(d){
            if(d && d.city && d.latitude) setLoc(d.latitude, d.longitude, d.city, true);
            else throw new Error('ipapi: no city');
          });
      })
      .catch(function(){ showStatus('<%- t('locIpFailed') %>', 'err'); });
  });
  // Upload-zone previews: show thumbnail + file name, X clears the pick.
  document.querySelectorAll('input[data-upz]').forEach(function(inp){
    inp.addEventListener('change', function(){
      var box=document.getElementById(inp.dataset.upz); if(!box) return;
      var f=inp.files[0];
      if(!f){ box.classList.remove('show'); return; }
      var r=new FileReader();
      r.onload=function(e){ box.querySelector('img').src=e.target.result; box.querySelector('.upz-name').textContent=f.name; box.classList.add('show'); };
      r.readAsDataURL(f);
    });
  });
  document.querySelectorAll('.upz-x').forEach(function(x){
    x.addEventListener('click', function(){
      var inp=document.querySelector('input[name="'+x.dataset.clear+'"]');
      if(inp) inp.value='';
      var box=x.closest('.upz-prev'); if(box){ box.classList.remove('show'); box.querySelector('img').removeAttribute('src'); }
    });
  });
  // Shrink photos in the browser before upload: a 10MB phone photo becomes
  // ~100KB, so saving is fast even on slow data. The server shrinks again
  // as a safety net. If shrinking fails, the original file is sent as-is.
  var form=document.getElementById('onbForm'), saveBtn=document.getElementById('saveBtn'),
      hint=document.getElementById('saveHint');
  function shrink(file){
    return new Promise(function(resolve){
      if(!file || file.type.indexOf('image/')!==0 || file.size < 300*1024) return resolve(file);
      var img=new Image();
      img.onload=function(){
        var max=800, w=img.width, h=img.height;
        if(w>max || h>max){ var s=Math.min(max/w, max/h); w=Math.round(w*s); h=Math.round(h*s); }
        var c=document.createElement('canvas'); c.width=w; c.height=h;
        c.getContext('2d').drawImage(img,0,0,w,h);
        c.toBlob(function(b){ resolve(b ? new File([b], file.name.replace(/\.[^.]+$/,'')+'.jpg', {type:'image/jpeg'}) : file); }, 'image/jpeg', 0.82);
      };
      img.onerror=function(){ resolve(file); };
      img.src=URL.createObjectURL(file);
    });
  }
  if(form) form.addEventListener('submit', function(e){
    var inputs=form.querySelectorAll('input[type=file]');
    var hasBig=false;
    inputs.forEach(function(i){ if(i.files[0] && i.files[0].size > 300*1024) hasBig=true; });
    if(!hasBig || form.dataset.shrunk) return;
    e.preventDefault();
    saveBtn.disabled=true; saveBtn.textContent='Shrinking photos…';
    hint.textContent='Making your photos small so they save fast…';
    var jobs=[];
    inputs.forEach(function(inp){
      if(inp.files[0]) jobs.push(shrink(inp.files[0]).then(function(f){
        var dt=new DataTransfer(); dt.items.add(f); inp.files=dt.files;
      }));
    });
    Promise.all(jobs).then(function(){
      form.dataset.shrunk='1';
      saveBtn.textContent='Saving…';
      form.submit();
    }).catch(function(){ form.dataset.shrunk='1'; form.submit(); });
  });
})();
</script>
