<% var goalLabel = {serious:'Serious relationship', marriage:'Marriage', casual:'Casual dating', friendship:'Friendship first'}[p.relationship_goal] || 'Still figuring it out'; %>
<% var genderLabel = me.gender === 'female' ? 'Female' : me.gender === 'male' ? 'Male' : '—'; %>
<% var lookingLabel = p.looking_for_gender === 'female' ? 'Female' : p.looking_for_gender === 'male' ? 'Male' : 'Anyone'; %>
<div class="me-top">
  <a class="points-pill" href="/premium"><%- icon('heart', true) %> <%= user.is_premium ? 'Premium' : (freeLeft + ' free left') %></a>
  <a class="icon-btn-round" href="/settings" aria-label="Settings"><%- icon('settings') %></a>
</div>
<div class="me-head">
  <% if (p.photo1) { %><img class="me-photo" src="<%= p.photo1_thumb || p.photo1 %>" alt="<%= me.name %>"><% } else { %><div class="me-photo avatar-ph"><%- icon('user') %></div><% } %>
  <h1 class="me-name"><%= me.name %></h1>
  <p class="me-meta"><%= p.city || '' %><%= p.country ? ', ' + p.country : '' %> · <%= me.age %> years</p>
</div>
<a class="me-row" href="/u/<%= me.id %>?preview=1"><span class="row-ico c-eye"><%- icon('eye') %></span><span class="lbl">Preview Profile</span><span class="chev"><%- icon('chevronRight') %></span></a>
<div class="me-section">
  <div class="me-section-head"><h2>Photos</h2><span class="sub">Tap to add and edit, drag to reorder</span></div>
  <div class="photo-grid" id="photoGrid">
    <% [1,2,3].forEach(function(slot){ var ph = p['photo'+slot]; var th = p['photo'+slot+'_thumb']; %>
    <div class="photo-tile<%= ph ? '' : ' empty' %>" data-slot="<%= slot %>">
      <% if (ph) { %>
        <img src="<%= th || ph %>" alt="" draggable="false">
        <% if (slot===1) { %><span class="photo-main">Main</span><% } %>
        <span class="photo-grip"><%- icon('grip') %></span>
        <button type="button" class="photo-x" data-remove="<%= slot %>" aria-label="Remove photo"><%- icon('x') %></button>
      <% } else { %>
        <span class="photo-add"><%- icon('plus') %></span>
      <% } %>
    </div>
    <% }) %>
  </div>
  <input type="file" id="photoReplaceInput" accept="image/*" hidden>
</div>
<% if (me.email_verified) { %>
<span class="me-row"><span class="row-ico c-green"><%- icon('shield') %></span><span class="lbl">Verify Yourself<small>Verified</small></span><span class="chev ok"><%- icon('checkCircle') %></span></span>
<% } else if (me.email) { %>
<form method="post" action="/verify-email/resend" class="me-row-form">
  <input type="hidden" name="email" value="<%= me.email %>">
  <button type="submit" class="me-row"><span class="row-ico c-shield"><%- icon('shield') %></span><span class="lbl">Verify Yourself<small>Tap to send a verification link to your email</small></span><span class="chev"><%- icon('chevronRight') %></span></button>
</form>
<% } else { %>
<span class="me-row"><span class="row-ico c-shield"><%- icon('shield') %></span><span class="lbl">Verify Yourself<small>Add an email to verify your profile</small></span></span>
<% } %>
<div class="me-section">
  <h2>About Me</h2>
  <div class="about-rows">
    <a class="about-row" href="/profile/edit#field-bio"><span class="row-ico c-edit"><%- icon('edit') %></span><span class="lbl">Bio</span><span class="row-val"><%= p.bio ? (p.bio.length > 40 ? p.bio.slice(0, 40) + '…' : p.bio) : 'Add a bio' %></span><span class="chev"><%- icon('chevronRight') %></span></a>
    <span class="about-row"><span class="row-ico c-user"><%- icon('user') %></span><span class="lbl">Gender</span><span class="row-val"><%= genderLabel %></span><span class="chev lock"><%- icon('lock') %></span></span>
    <span class="about-row"><span class="row-ico c-smile"><%- icon('smile') %></span><span class="lbl">Age</span><span class="row-val"><%= me.age %> years</span><span class="chev lock"><%- icon('lock') %></span></span>
    <a class="about-row" href="/profile/edit#field-religion"><span class="row-ico c-star"><%- icon('star') %></span><span class="lbl">Religion</span><span class="row-val"><%= p.religion || '—' %></span><span class="chev"><%- icon('chevronRight') %></span></a>
    <a class="about-row" href="/profile/edit#field-goal"><span class="row-ico c-heart"><%- icon('heart') %></span><span class="lbl">Relationship goal</span><span class="row-val"><%= goalLabel %></span><span class="chev"><%- icon('chevronRight') %></span></a>
    <a class="about-row" href="/profile/edit#field-height"><span class="row-ico c-info"><%- icon('info') %></span><span class="lbl">Height</span><span class="row-val"><%= p.height_cm ? p.height_cm + ' cm' : '—' %></span><span class="chev"><%- icon('chevronRight') %></span></a>
    <a class="about-row" href="/profile/edit#field-education"><span class="row-ico c-book"><%- icon('book') %></span><span class="lbl">Education</span><span class="row-val"><%= p.education || '—' %></span><span class="chev"><%- icon('chevronRight') %></span></a>
    <a class="about-row" href="/profile/edit#field-job"><span class="row-ico c-briefcase"><%- icon('briefcase') %></span><span class="lbl">Job</span><span class="row-val"><%= p.job || '—' %></span><span class="chev"><%- icon('chevronRight') %></span></a>
    <a class="about-row" href="/profile/edit#field-birthplace"><span class="row-ico c-pin"><%- icon('pin') %></span><span class="lbl">Birth Place</span><span class="row-val"><%= p.birth_place || '—' %></span><span class="chev"><%- icon('chevronRight') %></span></a>
    <a class="about-row" href="/profile/edit#field-languages"><span class="row-ico c-globe"><%- icon('globe') %></span><span class="lbl">Languages</span><span class="row-val"><%= p.languages || '—' %></span><span class="chev"><%- icon('chevronRight') %></span></a>
    <a class="about-row" href="/profile/edit#field-interests"><span class="row-ico c-flame"><%- icon('flame') %></span><span class="lbl">Interests</span><span class="row-val"><%= interestsList.length ? interestsList.join(', ') : '—' %></span><span class="chev"><%- icon('chevronRight') %></span></a>
    <a class="about-row" href="/profile/edit#field-zodiac"><span class="row-ico c-zodiac"><%- icon('star', true) %></span><span class="lbl">Zodiac sign</span><span class="row-val"><%= p.zodiac || '—' %></span><span class="chev"><%- icon('chevronRight') %></span></a>
    <a class="about-row" href="/settings"><span class="row-ico c-sliders"><%- icon('sliders') %></span><span class="lbl">Match Preferences</span><span class="row-val"><%= lookingLabel %> · <%= p.age_min %>–<%= p.age_max %></span><span class="chev"><%- icon('chevronRight') %></span></a>
  </div>
</div>
