<h1 class="page-title"><%= t('forgotPassword') %></h1>
<p class="sub">Enter the email on your account. We will send a reset link (valid 1 hour).</p>
<form method="post" action="/forgot-password">
  <div class="field"><label>Email</label><input type="email" name="email" required></div>
  <button class="btn btn-pink btn-block" type="submit">Send reset link</button>
</form>
<p class="sub" style="margin-top:14px"><a href="/signin"><%= t('signIn') %></a></p>
