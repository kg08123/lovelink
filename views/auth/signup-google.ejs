<h1 class="page-title"><%= t('signUp') %></h1>
<p class="sub">Signed in with Google as <b><%= g.name %></b> (<%= g.email || 'no email' %>). Finish your account — 18+ only.</p>
<form method="post" action="/signup/google">
  <div class="field"><label>Full name *</label><input type="text" name="name" required value="<%= g.name || '' %>"></div>
  <div class="field"><label>Phone *</label><input type="text" name="phone" required placeholder="09..."></div>
  <div class="field"><label>Gender *</label>
    <select name="gender" required>
      <option value="">—</option>
      <option value="male">Male</option>
      <option value="female">Female</option>
    </select>
  </div>
  <div class="field"><label>Age * (must be 18+)</label><input type="number" name="age" required min="18" max="100"></div>
  <button class="btn btn-pink btn-block" type="submit"><%= t('signUp') %></button>
</form>
