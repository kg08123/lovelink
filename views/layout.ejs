<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>LoveLink — <%= typeof title !== 'undefined' ? title : t('appTag') %></title>
<link rel="stylesheet" href="/css/style.css">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23FF2E63'%3E%3Cpath d='M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z'/%3E%3C/svg%3E">
</head>
<body<%- typeof bodyClass !== 'undefined' && bodyClass ? ' class="' + bodyClass + '"' : '' %>>
<% var isLanding = typeof bodyClass !== 'undefined' && bodyClass === 'landing'; %>
<% var isChat = typeof bodyClass !== 'undefined' && bodyClass === 'chat-page'; %>
<% if (!isLanding) { %>
<header class="topbar">
  <div class="topbar-in">
    <a class="logo" href="/"><span class="logo-heart"><%- icon('heart', true) %></span>Love<span class="logo-link">Link</span></a>
    <nav class="navlinks">
      <% if (user && (profile || user.role === 'admin')) { %>
        <a class="msg-ico" href="/messages" aria-label="<%= t('messages') %>"><%- icon('comment') %><% if (unreadCount > 0) { %><span class="badge"><%= unreadCount > 99 ? '99+' : unreadCount %></span><% } %></a>
        <button class="hamb" id="menuBtn" aria-label="menu"><%- icon('menu') %></button>
      <% } else if (user) { %>
        <a href="/signout" style="font-weight:700; color:var(--red); text-decoration:none"><%= t('signOut') %></a>
      <% } else { %>
        <a class="btn-signin" href="/signin"><%= t('signIn') %></a>
      <% } %>
      <span class="lang-toggle">
        <a href="?lang=en" class="<%= lang==='en'?'on':'' %>">EN</a><a href="?lang=am" class="<%= lang==='am'?'on':'' %>">አማ</a>
      </span>
    </nav>
  </div>
</header>
<% if (user && (profile || user.role === 'admin')) { %>
<div class="drawer-backdrop" id="drawerBackdrop" hidden></div>
<aside class="drawer" id="drawer" aria-label="menu">
  <div class="drawer-head">
    <div class="drawer-avatar"><%= user.name ? user.name.trim()[0].toUpperCase() : 'L' %></div>
    <div class="grow">
      <b><%= user.name %></b>
      <span class="sub" style="margin:0"><%= user.role === 'admin' ? t('adminPanel') : (user.is_premium ? 'Premium' : t('profile')) %></span>
    </div>
    <button class="icon-btn drawer-close" id="drawerClose" aria-label="close"><%- icon('x') %></button>
  </div>
  <nav class="drawer-nav">
    <% if (user.role === 'admin') { %>
      <a href="/admin"><%- icon('grid') %><%= t('adminPanel') %></a>
      <a href="/admin/users"><%- icon('users') %><%= t('allUsers') %></a>
      <a href="/admin/payments"><%- icon('cash') %><%= t('paymentReceipts') %></a>
      <a href="/admin/reports"><%- icon('file') %><%= t('reportsQueue') %></a>
    <% } else { %>
      <a href="/discover"><%- icon('flame') %><%= t('discover') %></a>
      <a href="/explore"><%- icon('search') %><%= t('explore') %></a>
      <a href="/matches"><%- icon('heart') %><%= t('matches') %></a>
      <a href="/profile"><%- icon('user') %><%= t('profile') %></a>
      <a href="/premium"><%- icon('star') %><%= t('premiumTitle') %></a>
    <% } %>
    <a href="/messages"><%- icon('comment') %><%= t('messages') %></a>
    <a href="/settings"><%- icon('settings') %><%= t('settings') %></a>
    <a href="/about"><%- icon('info') %><%= t('aboutUs') %></a>
    <a href="/signout" class="danger"><%- icon('logout') %><%= t('signOut') %></a>
  </nav>
</aside>
<% } %>
<% } %>
<main class="wrap">
  <% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.msg %></div><% } %>
  <%- body %>
</main>
<% if (user && user.role !== 'admin' && profile && !isLanding && !isChat) { %>
<nav class="bottomnav">
  <a href="/discover" class="<%= navActive==='discover' ? 'on' : '' %>"><span class="bn-ico"><%- icon('flame', navActive==='discover') %></span><%= t('discover') %></a>
  <a href="/matches" class="<%= navActive==='matches' ? 'on' : '' %>"><span class="bn-ico"><%- icon('heart', navActive==='matches') %></span><%= t('matches') %></a>
  <a href="/messages" class="<%= navActive==='messages' ? 'on' : '' %>"><span class="bn-ico"><%- icon('comment') %></span><%= t('messages') %><% if (unreadCount > 0) { %><span class="bn-badge"><%= unreadCount > 99 ? '99+' : unreadCount %></span><% } %></a>
  <a href="/profile" class="<%= navActive==='profile' ? 'on' : '' %>"><span class="bn-ico"><%- icon('user') %></span><%= t('profile') %></a>
</nav>
<% } %>
<% if (!isLanding) { %>
<footer class="footer">LoveLink · <%= t('appTag') %> · Addis Ababa, Ethiopia<br><a href="/about"><%= t('aboutUs') %></a> · <a href="/privacy"><%= t('privacyTitle') %></a></footer>
<% } %>
<script>
function copyNum(id){const el=document.getElementById(id);if(!el)return;navigator.clipboard&&navigator.clipboard.writeText(el.innerText.trim());}
(function(){
  var b=document.getElementById('menuBtn'), d=document.getElementById('drawer'),
      bg=document.getElementById('drawerBackdrop'), x=document.getElementById('drawerClose');
  if(!b||!d) return;
  function open(){ d.classList.add('open'); bg.hidden=false; document.body.style.overflow='hidden'; }
  function close(){ d.classList.remove('open'); bg.hidden=true; document.body.style.overflow=''; }
  b.addEventListener('click', function(e){ e.stopPropagation(); open(); });
  if(x) x.addEventListener('click', close);
  if(bg) bg.addEventListener('click', close);
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') close(); });
})();
</script>
</body>
</html>
